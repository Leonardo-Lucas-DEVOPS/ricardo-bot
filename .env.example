# ==========================================================================
#  Ricardo Bot — modelo do .env
#  Copie para ".env" e preencha. O .env NUNCA vai pro git.
# ==========================================================================

# --- Gemini -----------------------------------------------------------
# Três chaves, UMA ativa. Trocar = mudar o número em GEMINI_KEY_ATIVA
# e reiniciar. Não existe rodízio automático (ver doc 08).
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_ATIVA=1

# Modelo travado. Ver doc 11, seção 2.
GEMINI_MODELO=gemini-3.5-flash-lite

# --- Negócio ----------------------------------------------------------
CHAVE_PIX=
NOME_EMPRESA=

# Seu WhatsApp pessoal, formato internacional só com dígitos: 5511999998888
# É pra onde vão os avisos de pedido e os pedidos de socorro (M9),
# e é o ÚNICO número de onde os comandos /pausar /voltar são aceitos.
WHATSAPP_RICARDO=

# --- Operação ---------------------------------------------------------
HORA_LIMITE_ENTREGA=21
ENTREGA_FIM_DE_SEMANA=false
FUSO=America/Sao_Paulo

CUTUCADAS_LIGADAS=true
PAINEL_PORTA=3100

# Transcrição de áudio (decisão de 29/08/2026 — ver doc 11, seção 9)
AUDIO_TRANSCRICAO=true
AUDIO_MAX_SEGUNDOS=120
